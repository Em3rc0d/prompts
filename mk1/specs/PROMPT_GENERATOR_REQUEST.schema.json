{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-quarry.local/mk1/prompt-generator-request.schema.json",
  "title": "Prompt Quarry MK1 Prompt Generator v0 Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "request"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "request": {
      "type": "string",
      "minLength": 8
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "intent": {
      "type": "string",
      "enum": ["answer", "analyze", "audit", "compare", "decide", "generate", "plan", "research", "review", "rewrite", "summarize", "teach", "troubleshoot"]
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "risk": {
      "type": "string",
      "enum": ["low", "normal", "high-stakes"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "moderate", "complex"]
    },
    "interaction": {
      "type": "string",
      "enum": ["one-shot", "intake-allowed", "iterative"]
    },
    "language": {
      "type": "string",
      "enum": ["es", "en", "mixed"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "output_needs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured", "alternatives", "evidence", "citations"],
      "properties": {
        "structured": {"type": "boolean"},
        "alternatives": {"type": "integer", "minimum": 1, "maximum": 20},
        "evidence": {"type": "boolean"},
        "citations": {"type": "boolean"}
      }
    },
    "model_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["model-agnostic", "chatgpt", "claude", "gemini", "codex", "image-model"]
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
