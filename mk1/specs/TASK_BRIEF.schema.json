{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-quarry.local/mk1/task-brief.schema.json",
  "title": "Prompt Quarry MK1 Task Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "title",
    "intent",
    "domain",
    "risk",
    "complexity",
    "goal",
    "inputs",
    "success_criteria",
    "interaction",
    "output_needs"
  ],
  "properties": {
    "brief_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "intent": {
      "type": "string",
      "enum": [
        "answer",
        "analyze",
        "audit",
        "compare",
        "decide",
        "generate",
        "plan",
        "research",
        "review",
        "rewrite",
        "summarize",
        "teach",
        "troubleshoot"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "risk": {
      "type": "string",
      "enum": ["low", "normal", "high-stakes"]
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "moderate", "complex"]
    },
    "goal": {
      "type": "string",
      "minLength": 5
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "interaction": {
      "type": "string",
      "enum": ["one-shot", "intake-allowed", "iterative"]
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2},
      "default": []
    },
    "output_needs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured", "alternatives", "evidence", "citations"],
      "properties": {
        "structured": {"type": "boolean"},
        "alternatives": {"type": "integer", "minimum": 1, "maximum": 20},
        "evidence": {"type": "boolean"},
        "citations": {"type": "boolean"}
      }
    },
    "model_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["model-agnostic", "chatgpt", "claude", "gemini", "codex", "image-model"]
      },
      "default": ["model-agnostic"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
