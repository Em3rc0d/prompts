{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptquarry.local/mk0/harvester/HUMAN_REVIEW.schema.json",
  "title": "Prompt Quarry Human Review Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "candidate_id",
    "candidate_fingerprint",
    "policy_version",
    "reviewer_role",
    "decision",
    "decision_reason_codes",
    "rationale",
    "reviewed_at",
    "machine_confidence_at_review",
    "machine_route_at_review"
  ],
  "properties": {
    "schema": {"const": "prompt-quarry-human-review-v1"},
    "review_id": {"type": "string", "pattern": "^review-[a-z0-9][a-z0-9-]{5,80}$"},
    "candidate_id": {"type": "string", "pattern": "^cand-[a-z0-9][a-z0-9-]{5,80}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reviewer_role": {"enum": ["human-owner", "human-reviewer", "legal-reviewer", "provenance-reviewer"]},
    "decision": {"enum": ["APPROVE_CANDIDATE", "REJECT", "CORRECT_AND_REQUEUE", "HOLD", "ESCALATE"]},
    "decision_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "rationale": {"type": "string", "minLength": 10},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "machine_confidence_at_review": {"type": "number", "minimum": 0, "maximum": 1},
    "machine_route_at_review": {"enum": ["GOLDEN_CANDIDATE", "HUMAN_REVIEW_REQUIRED", "HOLD", "REJECTED"]},
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "old_value", "new_value", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "old_value": {},
          "new_value": {},
          "reason": {"type": "string", "minLength": 5}
        }
      }
    },
    "source_commit": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "CORRECT_AND_REQUEUE"}}, "required": ["decision"]},
      "then": {"required": ["corrections"], "properties": {"corrections": {"minItems": 1}}}
    }
  ]
}
