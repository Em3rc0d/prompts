NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INDEXING_MODE=off
NEXT_PUBLIC_FREE_PACK_URL=
NEXT_PUBLIC_DEVELOPER_PACK_SALE_STATUS=NOT_FOR_SALE
NEXT_PUBLIC_STARTER_COLLECTION_SALE_STATUS=NOT_FOR_SALE
NEXT_PUBLIC_STARTER_CODE_REVIEW_SALE_STATUS=NOT_FOR_SALE
NEXT_PUBLIC_ANALYTICS_MODE=off

DEVELOPER_PACK_COMMERCE_MODE=off
STARTER_COLLECTION_COMMERCE_MODE=off
STARTER_CODE_REVIEW_COMMERCE_MODE=off

# Legacy Lemon Squeezy products remain isolated from Verlune Premium.
LEMONSQUEEZY_DEVELOPER_PACK_TEST_CHECKOUT_URL=
LEMONSQUEEZY_DEVELOPER_PACK_LIVE_CHECKOUT_URL=
LEMONSQUEEZY_STARTER_TEST_CHECKOUT_URL=
LEMONSQUEEZY_STARTER_LIVE_CHECKOUT_URL=
LEMONSQUEEZY_STARTER_CODE_REVIEW_TEST_CHECKOUT_URL=
LEMONSQUEEZY_STARTER_CODE_REVIEW_LIVE_CHECKOUT_URL=
LEMONSQUEEZY_PROVIDER_TEST_TOKEN=
LEMONSQUEEZY_LIVE_CANARY_TOKEN=
LEMONSQUEEZY_STARTER_PROVIDER_TEST_TOKEN=
LEMONSQUEEZY_STARTER_LIVE_CANARY_TOKEN=
LEMONSQUEEZY_STARTER_CODE_REVIEW_PROVIDER_TEST_TOKEN=
LEMONSQUEEZY_STARTER_CODE_REVIEW_LIVE_CANARY_TOKEN=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STARTER_CODE_REVIEW_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_DEVELOPER_PACK_PRODUCT_ID=
LEMONSQUEEZY_DEVELOPER_PACK_VARIANT_ID=
LEMONSQUEEZY_STARTER_PRODUCT_ID=
LEMONSQUEEZY_STARTER_VARIANT_ID=
LEMONSQUEEZY_STARTER_CODE_REVIEW_PRODUCT_ID=
LEMONSQUEEZY_STARTER_CODE_REVIEW_VARIANT_ID=

# Verlune Premium — Mercado Pago Payments API / Checkout API.
# Price is fixed server-side: S/ 17.00 (~US$5 launch price).
VERLUNE_PREMIUM_PRICE_PEN_MINOR=1700
VERLUNE_PREMIUM_COMMERCE_MODE=off
VERLUNE_PREMIUM_PUBLIC_SALE_STATUS=NOT_FOR_SALE
VERLUNE_PREMIUM_PROVIDER_TEST_TOKEN=

# Mercado Pago server credentials. Never expose Access Token or webhook secret.
MP_ENVIRONMENT=test
MP_ALLOW_LIVE=false
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
# Optional explicit HTTPS notification URL. Otherwise the current HTTPS deployment origin is used.
MP_NOTIFICATION_URL=

VERLUNE_SESSION_SECRET=
# Retained name for compatibility; used to HMAC purchase-email identity in the signed session.
VERLUNE_LICENSE_FINGERPRINT_SECRET=
VERLUNE_SESSION_MAX_AGE_SECONDS=604800
VERLUNE_SESSION_REVALIDATE_SECONDS=900
