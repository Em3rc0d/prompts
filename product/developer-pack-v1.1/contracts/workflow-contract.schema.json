{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptquarry.local/schemas/developer-pack-v1.1/workflow-contract.schema.json",
  "title": "Prompt Quarry Workflow Contract v1.1",
  "description": "Machine-readable representation of a governed AI-assisted workflow. Static contract only; it does not imply runtime or F4-F7 evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "workflow_id",
    "outcome",
    "inputs",
    "context_policy",
    "evidence_policy",
    "decision_policy",
    "output_contract",
    "verification"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional", "missing_required_state"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "missing_required_state": {
          "type": "string",
          "enum": ["BLOCKED", "NEEDS_REVIEW", "READY_WITH_UNKNOWNS"]
        },
        "ambiguity_rule": {
          "type": "string"
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_sources", "unknown_rule"],
      "properties": {
        "allowed_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "external_research": {
          "type": "boolean",
          "default": false
        },
        "source_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "freshness": {
          "type": ["string", "null"]
        },
        "citation_policy": {
          "type": "string",
          "enum": ["none", "material_external_claims", "all_external_claims"]
        },
        "unknown_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "strongest_conclusion_threshold"],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "meaning"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "meaning": {"type": "string", "minLength": 1}
            }
          }
        },
        "forbidden_promotions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "strongest_conclusion_threshold": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must": {
          "type": "array",
          "items": {"type": "string"}
        },
        "must_not": {
          "type": "array",
          "items": {"type": "string"}
        },
        "preserve": {
          "type": "array",
          "items": {"type": "string"}
        },
        "priority_order": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "process": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instruction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "state"],
            "properties": {
              "when": {"type": "string", "minLength": 1},
              "state": {"type": "string", "minLength": 1}
            }
          }
        },
        "authority": {
          "type": "string",
          "enum": ["advisory", "human_decides", "blocking_gate"]
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sections"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["markdown", "json", "yaml", "text", "custom"]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "pass_states"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "pass_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_states": {
          "type": "array",
          "items": {"type": "string"}
        },
        "instruction": {
          "type": "string"
        }
      }
    },
    "evidence_boundary": {
      "const": "Local contract validation does not establish Prompt Quarry F4 TESTED, F5 IMPROVED, F6 CERTIFIED, or F7 PORTABLE."
    }
  }
}
